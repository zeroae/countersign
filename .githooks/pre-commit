#!/usr/bin/env bash
# Fast checks on the staged change only: rustfmt on staged Rust files and
# ESLint on the staged JavaScript that `pnpm lint` covers. No build, no test
# suite and no network call: the CI workflow (.github/workflows/ci.yml) runs
# those.
# Written for bash 3.2, the bash macOS ships.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
status=0

staged() {
  git diff --cached --name-only -z --diff-filter=ACMR -- "$@"
}

# The rustfmt of the toolchain rust-toolchain.toml pins, found once. `rustup
# which` fails on a toolchain that is not installed, where the rustfmt proxy
# would download it.
find_rustfmt() {
  if command -v rustup >/dev/null 2>&1; then
    local channel
    channel=$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)
    if ! rustup which --toolchain "$channel" rustfmt 2>/dev/null; then
      echo "pre-commit: rustfmt of the pinned toolchain $channel is not installed. Run 'rustup show' in the checkout, which installs it, then commit again." >&2
      return 1
    fi
  else
    command -v rustfmt || { echo "pre-commit: rustfmt is not installed." >&2; return 1; }
  fi
}

# rustfmt reads each staged blob on stdin, so a file whose working copy differs
# from what is staged is judged by what will be committed.
rust_files=()
while IFS= read -r -d '' file; do
  rust_files+=("$file")
done < <(staged '*.rs')

if [ ${#rust_files[@]} -gt 0 ]; then
  if ! rustfmt=$(find_rustfmt); then
    status=1
  else
    edition=$(sed -n 's/^edition *= *"\(.*\)"/\1/p' Cargo.toml | head -n 1)
    unformatted=()
    for file in "${rust_files[@]}"; do
      git show ":$file" >"$tmp/in"
      if ! "$rustfmt" --edition "$edition" --emit stdout <"$tmp/in" >"$tmp/out" 2>"$tmp/err"; then
        echo "pre-commit: rustfmt could not check $file:" >&2
        cat "$tmp/err" >&2
        status=1
      elif ! cmp -s "$tmp/in" "$tmp/out"; then
        unformatted+=("$file")
      fi
    done
    if [ ${#unformatted[@]} -gt 0 ]; then
      echo "pre-commit: these staged Rust files are not formatted:" >&2
      printf '  %s\n' "${unformatted[@]}" >&2
      echo "Run 'cargo fmt --all', then 'git add' them again." >&2
      status=1
    fi
  fi
fi

# The paths the packages' lint scripts give ESLint, which `pnpm lint` runs.
# Other tracked JavaScript is not lint-clean, so the hook leaves it alone too.
# A file whose working copy matches the index is linted in one run; a partly
# staged file is linted from its staged blob on stdin.
js_whole=()
js_partial=()
while IFS= read -r -d '' file; do
  if git diff --quiet -- "$file"; then
    js_whole+=("$file")
  else
    js_partial+=("$file")
  fi
done < <(staged \
  ':(glob)packages/*/src/**/*.js' ':(glob)packages/*/src/**/*.mjs' ':(glob)packages/*/src/**/*.cjs' \
  ':(glob)packages/*/test/**/*.js' ':(glob)packages/*/test/**/*.mjs' ':(glob)packages/*/test/**/*.cjs' \
  ':(glob)examples/demo-integrator/*.js' ':(glob)examples/demo-integrator/site/*.js')

if [ $((${#js_whole[@]} + ${#js_partial[@]})) -gt 0 ]; then
  eslint=node_modules/.bin/eslint
  if [ ! -x "$eslint" ]; then
    echo "pre-commit: ESLint skipped, no node_modules here; run 'pnpm install' to lint staged JavaScript. CI runs 'pnpm lint'." >&2
  else
    eslint_failed=0
    if [ ${#js_whole[@]} -gt 0 ]; then
      "$eslint" --no-warn-ignored -- "${js_whole[@]}" >&2 || eslint_failed=1
    fi
    for file in ${js_partial[@]+"${js_partial[@]}"}; do
      git show ":$file" | "$eslint" --no-warn-ignored --stdin --stdin-filename "$file" >&2 || eslint_failed=1
    done
    if [ $eslint_failed -ne 0 ]; then
      status=1
      echo "Fix what ESLint reports ('pnpm lint' lints the same files), then 'git add' them again." >&2
    fi
  fi
fi

if [ $status -ne 0 ]; then
  echo "pre-commit: commit refused. 'git commit --no-verify' skips this hook." >&2
fi
exit $status
