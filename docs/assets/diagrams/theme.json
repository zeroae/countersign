{
  "fontSize": 14,
  "theme": "base",
  "themeVariables": {
    "fontFamily": "set from palette.json",
    "fontSize": "14px",
    "background": "#ffffff",
    "primaryColor": "#f5eff9",
    "primaryTextColor": "#251c2b",
    "primaryBorderColor": "#7c628a",
    "lineColor": "#403748",
    "actorBkg": "#f5eff9",
    "actorBorder": "#7c628a",
    "actorTextColor": "#251c2b",
    "actorLineColor": "#cbbfd3",
    "signalColor": "#403748",
    "signalTextColor": "#251c2b",
    "labelTextColor": "#251c2b",
    "noteBkgColor": "#f6faf5",
    "noteTextColor": "#213c14",
    "noteBorderColor": "#a8bfa6"
  },
  "themeCSS": ".messageText{paint-order:stroke;stroke:#ffffff;stroke-width:6px;stroke-linejoin:round}",
  "htmlLabels": false,
  "deterministicIds": true,
  "deterministicIDSeed": "countersign",
  "sequence": {
    "diagramMarginX": 8,
    "diagramMarginY": 8,
    "width": 120,
    "height": 36,
    "actorMargin": 20,
    "boxMargin": 8,
    "noteMargin": 10,
    "messageMargin": 22,
    "mirrorActors": false,
    "wrap": true,
    "useMaxWidth": false
  }
}
